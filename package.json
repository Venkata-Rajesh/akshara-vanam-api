{
  "name": "akshara-vanam-api",
  "version": "1.0.0",
  "description": "Enterprise-grade Backend Service using Bun.js, Express.js, and Mongoose",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc --noEmit",
    "test": "bun test tests",
    "seed": "bun src/seed/seedData.ts",
    "admin:promote": "bun src/seed/promoteAdmin.ts",
    "admin:remove-demo": "bun src/seed/removeDemoAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "typescript": "~5.9.2"
  }
}
